#!/usr/bin/env python3
import re
import sys
from pathlib import Path

import openrazer.client


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "reactive"

    matugen_file = Path.home() / ".config" / "openrazer" / "matugen.txt"
    if not matugen_file.exists():
        return

    content = matugen_file.read_text().strip()
    match = re.search(r"rgb\s*\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*\)", content)
    if not match:
        return

    r, g, b = int(match.group(1)), int(match.group(2)), int(match.group(3))

    dm = openrazer.client.DeviceManager()
    for dev in dm.devices:
        try:
            if mode == "reactive":
                dev.fx.reactive(r, g, b, 0x01)  # 0x01 = fastest speed
            elif mode == "static":
                dev.fx.static(r, g, b)
            elif mode == "breath":
                dev.fx.breath_single(r, g, b)
        except Exception as e:
            print(f"Failed to set effect on {dev.name}: {e}")

if __name__ == "__main__":
    main()
