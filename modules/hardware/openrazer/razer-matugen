import re
import subprocess
import sys

import openrazer.client


def get_color_from_skate() -> tuple[int, int, int] | None:
    """Fetch the current RGB color from the skate key-value store."""
    try:
        res = subprocess.run(
            ["skate", "get", "primary_rgb@colors"],
            capture_output=True,
            text=True,
            check=True,
        )
        match = re.search(r"rgb\s*\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*\)", res.stdout.strip())
        if match:
            return int(match.group(1)), int(match.group(2)), int(match.group(3))
    except Exception as e:
        print(f"Could not read color from skate: {e}", file=sys.stderr)
    return None


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "reactive"

    rgb = get_color_from_skate()
    if not rgb:
        return

    r, g, b = rgb

    dm = openrazer.client.DeviceManager()
    for dev in dm.devices:
        try:
            if mode == "reactive":
                dev.fx.reactive(r, g, b, 0x01)  # 0x01 = fastest speed
            elif mode == "static":
                dev.fx.static(r, g, b)
            elif mode == "breath":
                dev.fx.breath_single(r, g, b)
        except Exception as e:
            print(f"Failed to set effect on {dev.name}: {e}", file=sys.stderr)


if __name__ == "__main__":
    main()
