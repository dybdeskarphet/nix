input {
    keyboard {
        xkb {
            layout "tr"
            options "caps:swapescape,altwin:swap_lalt_lwin"
        }
        numlock
    }
    touchpad {
        tap
        accel-profile "adaptive"
        scroll-method "two-finger"
    }
    mouse {
        accel-profile "adaptive"
    }

    focus-follows-mouse
    warp-mouse-to-focus
    disable-power-key-handling

}
