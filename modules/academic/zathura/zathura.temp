# -----------------------------------------------------------------------------
# Zathura Colors (Dynamic with Matugen)
# -----------------------------------------------------------------------------

set default-bg                  "{{colors.surface.default.hex}}"
set default-fg                  "{{colors.on_surface.default.hex}}"

set statusbar-bg                "{{colors.surface_container_low.default.hex}}"
set statusbar-fg                "{{colors.primary.default.hex}}"

set inputbar-bg                 "{{colors.surface_container_low.default.hex}}"
set inputbar-fg                 "{{colors.primary.default.hex}}"

set notification-error-bg       "{{colors.on_error.default.hex}}"
set notification-error-fg       "{{colors.error.default.hex}}"

set notification-warning-bg     "{{colors.primary_fixed.default.hex}}"
set notification-warning-fg     "{{colors.error_container.default.hex}}"

set notification-bg             "{{colors.surface_container_low.default.hex}}"
set notification-fg             "{{colors.primary.default.hex}}"

set completion-bg               "{{colors.surface_container_low.default.hex}}"
set completion-fg               "{{colors.primary.default.hex}}"
set completion-group-bg         "{{colors.surface_container_high.default.hex}}"
set completion-group-fg         "{{colors.outline.default.hex}}"
set completion-highlight-bg     "{{colors.primary.default.hex}}"
set completion-highlight-fg     "{{colors.surface_container_low.default.hex}}"

# Index Mode Colors
set index-bg                    "{{colors.surface_container_low.default.hex}}"
set index-fg                    "{{colors.on_surface.default.hex}}"
set index-active-bg             "{{colors.primary.default.hex}}"
set index-active-fg             "{{colors.on_primary.default.hex}}"

# Highlight Colors
set highlight-color             "{{colors.primary_fixed.default.hex}}"
set highlight-active-color      "{{colors.primary_fixed_dim.default.hex}}"

# Loading Indicator
set render-loading              true
set render-loading-bg           "{{colors.surface.default.hex}}"
set render-loading-fg           "{{colors.on_surface.default.hex}}"
