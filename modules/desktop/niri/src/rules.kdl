window-rule {
    match app-id=r#"^$"#
    match title=r#"^$"#
    open-floating true
    open-focused false
}

window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    match title=r#"Layer Select"#
    open-floating true
    open-focused false
}

window-rule {
    match app-id=r#"clipse$"#
    open-floating true
}

window-rule {
    match app-id=r#"qalc$"#
    open-floating true
}

window-rule {
    match app-id=r#"ntfyhistory$"#
    open-floating true
}

window-rule {
    match app-id=r#"todo$"#
    open-floating true
}

window-rule {
  match app-id=r#"python3"#
  open-floating true
}


layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

layer-rule {
    match namespace="^rofi$"
    geometry-corner-radius 12 
    background-effect {
        blur true
        xray false
    }
}


layer-rule {
    match namespace="^gtk-layer-shell$"
    geometry-corner-radius 12 
    background-effect {
        blur false
        xray false
    }
}

window-rule {
  match app-id="^footclient$" is-floating=true
  background-effect {
    xray false
    blur true
  }
}

window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"

    // Use this instead if you want them visible on third-party screenshot tools.
    // block-out-from "screencast"
}

window-rule {
  match app-id=r#"^org\.keepassxc\.KeePassXC$"# title="Unlock Database - KeePassXC"
  open-floating true
  open-focused true
}

// mpv needs this
window-rule {
  match app-id=r#"^mpv$"#
  tiled-state true
}
