# Main foreground and background
Stations            {{colors.secondary_fixed_dim.dark.hex}} {{colors.surface.dark.hex}}

# Playing station text color
# (background color will come from Stations)
Active Station            {{colors.tertiary.dark.hex}} {{colors.surface.dark.hex}}

# Status bar foreground and background
Status Bar          {{colors.primary.dark.hex}} {{colors.surface.dark.hex}}

# Normal cursor foreground and background
Normal Cursor       {{colors.on_primary.dark.hex}} {{colors.on_primary_container.dark.hex}}

# Cursor foreground and background
# when cursor on playing station
Active Cursor       {{colors.on_secondary.dark.hex}} {{colors.on_secondary_container.dark.hex}}

# Text color for extra function indication
# and jump numbers within the status bar
# (background color will come from Stations)
Extra Func          {{colors.surface.dark.hex}} {{colors.on_surface.dark.hex}}

# Text color for URL
# (background color will come from Stations)
PyRadio URL         {{colors.primary_fixed_dim.dark.hex}}
#
# Luminance Color Factor
# The factor to lighten or darken Stations background
# color, to get a calculated color used as background
# for secondary windows
# Valid values: 0 - 0.2
Color Factor        0.2

# Message window border foreground and background.
# The background color can be left unset.
# Please refer to the following link for more info
# https://github.com/coderholic/pyradio/blob/master/docs/themes.md#secondary-windows-background
#
Messages Border     {{colors.outline_variant.dark.hex}}
Border     {{colors.outline_variant.dark.hex}}

# Cursor foreground and background
# This is the Line Editor cursor
Edit Cursor       {{colors.on_primary.dark.hex}} {{colors.on_primary_container.dark.hex}}

# Theme Transparency
# Values are:
#   0: No transparency
#   1: Theme is transparent
#   2: Obey config setting (default)
transparency        1
