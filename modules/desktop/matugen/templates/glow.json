{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "{{colors.on_surface.dark.hex}}",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "{{colors.outline.dark.hex}}"
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "{{colors.primary.dark.hex}}",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "{{colors.on_primary.dark.hex}}",
    "background_color": "{{colors.primary.dark.hex}}",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "{{colors.secondary.dark.hex}}"
  },
  "h3": {
    "prefix": "### ",
    "color": "{{colors.tertiary.dark.hex}}"
  },
  "h4": {
    "prefix": "#### ",
    "color": "{{colors.primary_fixed.dark.hex}}"
  },
  "h5": {
    "prefix": "##### ",
    "color": "{{colors.secondary_fixed.dark.hex}}"
  },
  "h6": {
    "prefix": "###### ",
    "color": "{{colors.outline.dark.hex}}",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true,
    "color": "{{colors.outline.dark.hex}}"
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "{{colors.outline_variant.dark.hex}}",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": " ",
    "unticked": " "
  },
  "link": {
    "color": "{{colors.primary.dark.hex}}",
    "underline": true,
    "block_prefix": "(",
    "block_suffix": ")"
  },
  "link_text": {
    "color": "{{colors.primary.dark.hex}}",
    "bold": true
  },
  "image": {
    "color": "{{colors.secondary.dark.hex}}",
    "underline": true
  },
  "image_text": {
    "color": "{{colors.on_surface_variant.dark.hex}}",
    "format": "Image →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "{{colors.on_surface.dark.hex}}",
    "background_color": "{{colors.surface_container_highest.dark.hex}}"
  },
  "code_block": {
    "color": "{{colors.on_surface.dark.hex}}",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "{{colors.on_surface.dark.hex}}"
      },
      "error": {
        "color": "{{colors.error.dark.hex}}",
        "background_color": "{{colors.error_container.dark.hex}}"
      },
      "comment": {
        "color": "{{colors.outline.dark.hex}}"
      },
      "comment_preproc": {
        "color": "{{colors.tertiary.dark.hex}}"
      },
      "keyword": {
        "color": "{{colors.primary.dark.hex}}"
      },
      "keyword_reserved": {
        "color": "{{colors.error.dark.hex}}"
      },
      "keyword_namespace": {
        "color": "{{colors.secondary.dark.hex}}"
      },
      "keyword_type": {
        "color": "{{colors.tertiary.dark.hex}}"
      },
      "operator": {
        "color": "{{colors.outline.dark.hex}}"
      },
      "punctuation": {
        "color": "{{colors.outline_variant.dark.hex}}"
      },
      "name": {
        "color": "{{colors.on_surface.dark.hex}}"
      },
      "name_builtin": {
        "color": "{{colors.primary.dark.hex}}"
      },
      "name_tag": {
        "color": "{{colors.secondary.dark.hex}}"
      },
      "name_attribute": {
        "color": "{{colors.tertiary.dark.hex}}"
      },
      "name_class": {
        "color": "{{colors.primary.dark.hex}}",
        "underline": true,
        "bold": true
      },
      "name_constant": {
        "color": "{{colors.secondary.dark.hex}}"
      },
      "name_decorator": {
        "color": "{{colors.tertiary.dark.hex}}"
      },
      "name_exception": {
        "color": "{{colors.error.dark.hex}}"
      },
      "name_function": {
        "color": "{{colors.primary.dark.hex}}"
      },
      "name_other": {},
      "literal": {},
      "literal_number": {
        "color": "{{colors.secondary.dark.hex}}"
      },
      "literal_date": {},
      "literal_string": {
        "color": "{{colors.tertiary.dark.hex}}"
      },
      "literal_string_escape": {
        "color": "{{colors.primary.dark.hex}}"
      },
      "generic_deleted": {
        "color": "{{colors.error.dark.hex}}"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "{{colors.primary.dark.hex}}"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "{{colors.outline.dark.hex}}"
      },
      "background": {
        "background_color": "{{colors.surface_container.dark.hex}}"
      }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
